# Load via shell/secret manager; no automatic .env loading.
NOTIFICATION_DATABASE_URL=postgresql://NOTIFICATION_RUNTIME:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/smartgym_notification
HOST=127.0.0.1
PORT=3003
NOTIFICATION_AMQP_URL=amqps://notification_sub:REPLACE_URL_ENCODED_PASSWORD@broker.internal:5671/smartgym
# Consumer credentials: read email.v1 + workout.v1 queues only; no configure/publish/DLQ access.
# Provision both topologies with separate admin credentials before start; migrate schema to 002.
AMQP_CA_FILE=/run/secrets/broker-ca.crt
NOTIFICATION_ALLOW_LOOPBACK_PLAINTEXT=false
NOTIFICATION_IDENTITY_ORIGIN=https://identity.internal
NOTIFICATION_WEB_ORIGIN=https://smartgym.local
NOTIFICATION_IDENTITY_KEY_FILE=/run/secrets/notification-client.key
NOTIFICATION_IDENTITY_CERT_FILE=/run/secrets/notification-client.crt
NOTIFICATION_IDENTITY_CA_FILE=/run/secrets/identity-ca.crt
NOTIFICATION_TLS_KEY_FILE=/run/secrets/notification-server.key
NOTIFICATION_TLS_CERT_FILE=/run/secrets/notification-server.crt
NOTIFICATION_TLS_CA_FILE=/run/secrets/service-ca.crt
NOTIFICATION_PROBE_FINGERPRINTS=["REPLACE_PROBE_SHA256_FINGERPRINT"]
# Enable owner inbox/preferences APIs after configuring BFF mTLS and Identity issuer.
NOTIFICATION_API_ENABLED=false
NOTIFICATION_BFF_FINGERPRINTS=["REPLACE_BFF_SHA256_FINGERPRINT"]
NOTIFICATION_IDENTITY_ISSUER=https://identity.internal
SMTP_HOST=smtp.internal
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=noreply@REPLACE_APPROVED_DOMAIN
SMTP_USER=REPLACE_PROVIDER_USER
SMTP_PASSWORD_FILE=/run/secrets/smtp-password
# SMTP_CA_FILE=/run/secrets/smtp-ca.crt
# Operator reconciliation (requires external receipt evidence and DB authorization):
# pnpm --filter @smartgym/notification run resolve JOB_UUID CONFIRMED_SENT OP-operator CASE-evidence
