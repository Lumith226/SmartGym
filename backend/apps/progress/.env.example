DATABASE_URL=postgresql://progress_runtime:REPLACE@localhost:5432/smartgym_progress
PROGRESS_HOST=127.0.0.1
PROGRESS_PORT=3445
PROGRESS_BFF_FINGERPRINTS=[]
PROGRESS_TLS_KEY_FILE=/run/secrets/progress-server.key
PROGRESS_TLS_CERT_FILE=/run/secrets/progress-server.crt
PROGRESS_TLS_CA_FILE=/run/secrets/progress-ca.crt
PROGRESS_IDENTITY_ORIGIN=https://identity.internal
PROGRESS_IDENTITY_ISSUER=https://identity.internal
PROGRESS_IDENTITY_TLS_KEY_FILE=/run/secrets/progress-client.key
PROGRESS_IDENTITY_TLS_CERT_FILE=/run/secrets/progress-client.crt
PROGRESS_IDENTITY_TLS_CA_FILE=/run/secrets/identity-ca.crt
PROGRESS_CATALOG_ORIGIN=https://catalog-admin.internal:3101
PROGRESS_CATALOG_TLS_KEY_FILE=/run/secrets/progress-client.key
PROGRESS_CATALOG_TLS_CERT_FILE=/run/secrets/progress-client.crt
PROGRESS_CATALOG_TLS_CA_FILE=/run/secrets/catalog-admin-ca.crt
PROGRESS_WORKOUT_ORIGIN=https://workout.internal:3444
PROGRESS_WORKOUT_TLS_KEY_FILE=/run/secrets/progress-client.key
PROGRESS_WORKOUT_TLS_CERT_FILE=/run/secrets/progress-client.crt
PROGRESS_WORKOUT_TLS_CA_FILE=/run/secrets/workout-ca.crt
# Optional: unset keeps existing logs/summary usable and import returns POSE_UNAVAILABLE.
# When set, all TLS files are required and Pose must allowlist this client fingerprint as Progress.
PROGRESS_POSE_ORIGIN=https://pose.internal:3443
PROGRESS_POSE_TLS_KEY_FILE=/run/secrets/progress-client.key
PROGRESS_POSE_TLS_CERT_FILE=/run/secrets/progress-client.crt
PROGRESS_POSE_TLS_CA_FILE=/run/secrets/pose-ca.crt
