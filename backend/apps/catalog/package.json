{
  "name": "@smartgym/catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @smartgym/backend exec nest build catalog",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "media-worker": "node dist/media-worker.js",
    "import": "node dist/import.js",
    "dev:embedded": "pnpm run build && node test/dev.cjs",
    "test": "pnpm run build && node --test test/*.test.cjs",
    "relay": "node dist/relay-main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "amqplib": "2.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
