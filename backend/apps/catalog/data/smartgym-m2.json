  "exercises": [
    {
      "id": "bodyweight_squat",
      "slug": "squat-khong-ta",
      "nameVi": "Squat không tạ",
      "nameEn": "Bodyweight Squat",
      "summary": "Bài tập gập rồi duỗi hông và gối với trọng lượng cơ thể. Bản không tạ là động tác nền cho [Squat bật nhảy](squat_jump.md).",
      "primaryMuscleIds": [
        "quadriceps",
        "glutes"
      ],
      "secondaryMuscleIds": [],
      "equipmentIds": [
        "bodyweight"
      ],
      "instructions": [
        "Đứng với hai bàn chân ở khoảng rộng dễ giữ thăng bằng. Hướng mũi chân hơi chếch ra nếu thấy tự nhiên.",
        "Gập hông và gối để hạ người. Giữ bàn chân tiếp xúc với sàn và để đầu gối di chuyển cùng hướng mũi chân.",
        "Dừng ở độ sâu phù hợp với bài đang tập và vẫn kiểm soát được tư thế. Đẩy sàn để đứng lên."
      ],
      "commonMistakes": [
        "Lưng tròn khi hạ",
        "Đầu gối lệch hướng bàn chân",
        "Đầu gối chụm vào trong",
        "Xuống chưa đủ sâu"
      ],
      "media": [],
      "variants": [],
