# API, relay and materializer use only the Workout database.
# The materializer process needs DATABASE_URL only and requires migration 003.
DATABASE_URL=postgresql://workout_runtime:REPLACE@localhost:5432/smartgym_workout
WORKOUT_HOST=127.0.0.1
WORKOUT_PORT=3444
WORKOUT_BFF_FINGERPRINTS=[]
WORKOUT_PROGRESS_FINGERPRINTS=[]
WORKOUT_TLS_KEY_FILE=/run/secrets/workout-server.key
WORKOUT_TLS_CERT_FILE=/run/secrets/workout-server.crt
WORKOUT_TLS_CA_FILE=/run/secrets/workout-ca.crt
WORKOUT_IDENTITY_ORIGIN=https://identity.internal
WORKOUT_IDENTITY_ISSUER=https://identity.internal
WORKOUT_IDENTITY_TLS_KEY_FILE=/run/secrets/workout-client.key
WORKOUT_IDENTITY_TLS_CERT_FILE=/run/secrets/workout-client.crt
WORKOUT_IDENTITY_TLS_CA_FILE=/run/secrets/identity-ca.crt
WORKOUT_CATALOG_ORIGIN=https://catalog-admin.internal:3101
WORKOUT_CATALOG_TLS_KEY_FILE=/run/secrets/workout-client.key
WORKOUT_CATALOG_TLS_CERT_FILE=/run/secrets/workout-client.crt
WORKOUT_CATALOG_TLS_CA_FILE=/run/secrets/catalog-admin-ca.crt
# Independent relay. Publisher may write only smartgym.events.v1 / workout.occurrence.changed.v1.
WORKOUT_AMQP_URL=amqps://workout_pub:REPLACE@broker.internal:5671/smartgym
AMQP_CA_FILE=/run/secrets/broker-ca.crt
BROKER_ALLOW_LOOPBACK_PLAINTEXT=false
