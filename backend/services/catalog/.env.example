# Load from shell or secret manager.
DATABASE_URL=postgresql://CATALOG_RUNTIME:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/smartgym_catalog
HOST=127.0.0.1
PORT=3001
CATALOG_ADMIN_ENABLED=false
# Operator-owned allowlist JSON. Paths in entries are relative to this file's directory.
CATALOG_IMPORT_REGISTRY_FILE=/run/catalog-imports/registry.json
CATALOG_ADMIN_HOST=127.0.0.1
CATALOG_ADMIN_PORT=3101
CATALOG_ADMIN_BFF_FINGERPRINTS=["REPLACE_BFF_SHA256_FINGERPRINT"]
CATALOG_ADMIN_TLS_KEY_FILE=/run/secrets/catalog-admin.key
CATALOG_ADMIN_TLS_CERT_FILE=/run/secrets/catalog-admin.crt
CATALOG_ADMIN_TLS_CA_FILE=/run/secrets/service-ca.crt
CATALOG_IDENTITY_ORIGIN=https://identity.internal
CATALOG_IDENTITY_ISSUER=https://identity.internal
CATALOG_IDENTITY_TLS_KEY_FILE=/run/secrets/catalog-client.key
CATALOG_IDENTITY_TLS_CERT_FILE=/run/secrets/catalog-client.crt
CATALOG_IDENTITY_TLS_CA_FILE=/run/secrets/identity-ca.crt
CATALOG_MEDIA_ENABLED=false
# Certificates allowed to call internal exercise-refs, independent of CMS ADMIN access.
CATALOG_REF_FINGERPRINTS=[]
# Internal Catalog head/snapshot only; default empty denies all callers.
CATALOG_RAG_FINGERPRINTS=[]
# Separate optional relay process; never put topology admin credentials in runtime.
CATALOG_AMQP_URL=amqps://catalog_pub:REPLACE_URL_ENCODED_PASSWORD@broker.internal:5671/smartgym
AMQP_CA_FILE=/run/secrets/broker-ca.crt
BROKER_ALLOW_LOOPBACK_PLAINTEXT=false
CATALOG_MEDIA_PUBLIC_ORIGIN=https://catalog.example.invalid
CATALOG_MEDIA_S3_ENDPOINT=https://objects.example.invalid
CATALOG_MEDIA_REGION=us-east-1
CATALOG_MEDIA_BUCKET=smartgym-catalog-private
CATALOG_MEDIA_PREFIX=catalog/media
# Worker only. Set CLAMD_SOCKET for a Unix socket, or use the isolated scanner network.
CATALOG_MEDIA_FFPROBE=/usr/bin/ffprobe
CATALOG_MEDIA_FFMPEG=/usr/bin/ffmpeg
CATALOG_MEDIA_CLAMD_HOST=clamd.internal
CATALOG_MEDIA_CLAMD_PORT=3310
