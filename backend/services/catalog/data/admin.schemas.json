      "sizeBytes",
      "sha256"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "mime": {
              "enum": [
                "image/jpeg",
                "image/png",
                "image/webp"
              ]
            }
          },
          "required": [
            "mime"
          ]
        },
        "then": {
          "properties": {
            "sizeBytes": {
              "maximum": 10485760,
              "type": "integer"
            }
          }
        }
      }
    ]
  },
