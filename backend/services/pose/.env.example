# Private API. Supply secrets via deployment secret manager.
DATABASE_URL=postgresql://POSE_RUNTIME:REPLACE@127.0.0.1:5432/smartgym_pose
POSE_HOST=127.0.0.1
POSE_PORT=3443
POSE_UPLOAD_ENABLED=false
POSE_LIVE_ENABLED=false
POSE_CONSENT_VERSION=pose-v1
POSE_BFF_FINGERPRINTS=["REPLACE_BFF_SHA256_FINGERPRINT"]
POSE_PROGRESS_FINGERPRINTS=[]
POSE_TLS_KEY_FILE=/run/secrets/pose.key
POSE_TLS_CERT_FILE=/run/secrets/pose.crt
POSE_TLS_CA_FILE=/run/secrets/service-ca.crt
POSE_IDENTITY_ORIGIN=https://identity.internal
POSE_IDENTITY_ISSUER=https://identity.internal
POSE_IDENTITY_TLS_KEY_FILE=/run/secrets/pose-client.key
POSE_IDENTITY_TLS_CERT_FILE=/run/secrets/pose-client.crt
POSE_IDENTITY_TLS_CA_FILE=/run/secrets/identity-ca.crt
POSE_S3_BUCKET=smartgym-pose-private
POSE_S3_REGION=us-east-1
POSE_S3_ENDPOINT=https://objects.example.invalid
POSE_S3_PREFIX=pose/uploads
# Engine mTLS for the upload worker and live API. CA issues only authorized Pose identities.
POSE_ENGINE_ORIGIN=https://127.0.0.1:8001
POSE_ENGINE_TLS_KEY_FILE=/run/secrets/pose-worker.key
POSE_ENGINE_TLS_CERT_FILE=/run/secrets/pose-worker.crt
POSE_ENGINE_TLS_CA_FILE=/run/secrets/pose-engine-ca.crt
POSE_FFMPEG=/usr/bin/ffmpeg
POSE_FFPROBE=/usr/bin/ffprobe
POSE_TEMP_DIR=/run/pose-temp
