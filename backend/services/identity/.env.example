# Load these using your shell/secret manager. Service does not auto-load .env.
# Database owned by Identity only; use migration credentials separately when applying SQL.
IDENTITY_DATABASE_URL=postgresql://IDENTITY_RUNTIME:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/smartgym_identity
HOST=127.0.0.1
PORT=3002
IDENTITY_WEB_ORIGIN=https://smartgym.local
IDENTITY_ISSUER=https://identity.internal
IDENTITY_SIGNING_KID=identity-2026-01
IDENTITY_SIGNING_KEY_FILE=/run/secrets/identity-signing.pem
IDENTITY_DELIVERY_KEY_FILE=/run/secrets/identity-delivery.key
IDENTITY_LIMITER_KEY_FILE=/run/secrets/identity-limiter.key
IDENTITY_TLS_KEY_FILE=/run/secrets/identity-tls.key
IDENTITY_TLS_CERT_FILE=/run/secrets/identity-tls.crt
IDENTITY_TLS_CA_FILE=/run/secrets/service-ca.crt
# SHA-256 certificate fingerprints, uppercase hex with colons. Multiple values permit rotation.
IDENTITY_CALLER_FINGERPRINTS={"bff":["REPLACE_BFF_SHA256_FINGERPRINT"],"notification":["REPLACE_NOTIFICATION_SHA256_FINGERPRINT"]}
# Optional public RSA JWKS retained for old assertion verification (no private key fields).
# IDENTITY_PREVIOUS_JWKS_FILE=/run/secrets/identity-previous-public-jwks.json
# Independent relay process: pnpm --filter @smartgym/identity run relay
# Publisher user: write only smartgym.events.v1 and identity.email-action.requested.v1 topic.
IDENTITY_AMQP_URL=amqps://identity_pub:REPLACE_URL_ENCODED_PASSWORD@broker.internal:5671/smartgym
AMQP_CA_FILE=/run/secrets/broker-ca.crt
# Development-only loopback sandbox. Rejected in NODE_ENV=production.
BROKER_ALLOW_LOOPBACK_PLAINTEXT=false
