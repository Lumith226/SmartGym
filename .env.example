# Compose configuration. Choose distinct passwords and URL-encode them in connection strings.
SMARTGYM_WEB_ORIGIN=https://127.0.0.1:3100
# Enable collection together with the observability Compose profile.
# SMARTGYM_OTEL_DISABLED=false
# Per-container resource overrides, for example:
# SMARTGYM_POSE_ENGINE_MEMORY=4g
# SMARTGYM_OLLAMA_MEMORY=8g
# Optional absolute path to the private configuration directory. Default: .local/compose.
# SMARTGYM_CONFIG_DIR=
# Local AI asset paths. The Compose defaults use sibling projects and the installed Ollama models.
# SMARTGYM_POSE_SOURCE=
# pnpm start:local tries Docker CUDA first, then DirectML on Windows x64. Set cpu to skip GPU detection.
# SMARTGYM_POSE_ACCELERATION=auto
# Manual engine override for direct Docker Compose usage.
# SMARTGYM_POSE_ENGINE_ORIGIN=https://host.docker.internal:8002
# SMARTGYM_RAG_SOURCE=
# SMARTGYM_OLLAMA_MODELS=
# On Windows, a pre-populated Docker volume can avoid model reads over WSL 9p.
# SMARTGYM_OLLAMA_MODELS=smartgym-ollama-models
# Windows Ollama with Vulkan (after registering the background task).
# SMARTGYM_OLLAMA_ORIGIN=http://host.docker.internal:11434
# Launcher checks NVIDIA Docker, Windows Vulkan, or Linux Vulkan by default.
# SMARTGYM_OLLAMA_ACCELERATION=auto
# SMARTGYM_OLLAMA_WINDOWS_BINARY=C:/path/to/ollama.exe
SMARTGYM_CHAT_MODEL=qwen2.5:3b
# Optional cloud generation for standalone knowledge questions.
# SMARTGYM_QWEN_ENABLED=true
# SMARTGYM_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# SMARTGYM_QWEN_MODEL=qwen3.8-flash
# SMARTGYM_GEMINI_ENABLED=true
# SMARTGYM_GEMINI_MODEL=gemini-3.5-flash-lite
SMARTGYM_EMBED_MODEL=nomic-embed-text:latest
CATALOG_DB_PASSWORD=
CATALOG_DATABASE_URL=postgresql://smartgym_catalog:REPLACE_URL_ENCODED_PASSWORD@catalog-db:5432/smartgym_catalog
IDENTITY_DB_PASSWORD=
IDENTITY_DATABASE_URL=postgresql://smartgym_identity:REPLACE_URL_ENCODED_PASSWORD@identity-db:5432/smartgym_identity
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_DATABASE_URL=postgresql://smartgym_notification:REPLACE_URL_ENCODED_PASSWORD@notification-db:5432/smartgym_notification
WORKOUT_DB_PASSWORD=
WORKOUT_DATABASE_URL=postgresql://smartgym_workout:REPLACE_URL_ENCODED_PASSWORD@workout-db:5432/smartgym_workout
PROGRESS_DB_PASSWORD=
PROGRESS_DATABASE_URL=postgresql://smartgym_progress:REPLACE_URL_ENCODED_PASSWORD@progress-db:5432/smartgym_progress
POSE_DB_PASSWORD=
POSE_DATABASE_URL=postgresql://smartgym_pose:REPLACE_URL_ENCODED_PASSWORD@pose-db:5432/smartgym_pose
