# Shell/secret manager sets these values; node server.mjs does not auto-load .env.
HOST=127.0.0.1
PORT=3000
CATALOG_URL=http://127.0.0.1:3001
# Optional public origins. Set only for an environment ready to expose these URLs.
# WEB_PUBLIC_ORIGIN=https://gym.example.invalid
# WEB_CATALOG_MEDIA_ORIGIN=https://catalog-media.example.invalid
# Public-only mode works without Identity. Auth requires explicit HTTPS configuration.
BFF_AUTH_ENABLED=false
BFF_WEB_ORIGIN=https://smartgym.local
BFF_WEB_KEY_FILE=/run/secrets/web-server.key
BFF_WEB_CERT_FILE=/run/secrets/web-server.crt
BFF_IDENTITY_ORIGIN=https://identity.internal
BFF_IDENTITY_KEY_FILE=/run/secrets/web-bff-client.key
BFF_IDENTITY_CERT_FILE=/run/secrets/web-bff-client.crt
BFF_IDENTITY_CA_FILE=/run/secrets/identity-ca.crt
# Auth.js secret shared across Web instances. Set AUTH_SECRET securely or mount a secret file.
BFF_AUTHJS_SECRET_FILE=/run/secrets/authjs-secret
# Optional Google OAuth Web client. Add BFF_WEB_ORIGIN/api/auth/callback/google as a redirect URI in Google Cloud.
# BFF_GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
# BFF_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google-client-secret
BFF_POSE_LIVE_ENABLED=false
BFF_POSE_RECHECK_MS=30000
# RAG remains opt-in until real corpus/generation and ingress acceptance.
BFF_RAG_ENABLED=false
BFF_RAG_ORIGIN=https://rag.internal
BFF_RAG_RUNTIME_REVISION=REPLACE_16_HEX_RUNTIME_REVISION
BFF_RAG_TLS_KEY_FILE=/run/secrets/web-bff-client.key
BFF_RAG_TLS_CERT_FILE=/run/secrets/web-bff-client.crt
BFF_RAG_TLS_CA_FILE=/run/secrets/rag-ca.crt
BFF_RAG_TOKEN_FILE=/run/secrets/rag-internal-token
# Operator JSON array: id, rightsStatus=APPROVED, kind BOOK/HTML/NOTE, allowedOrigins.
BFF_RAG_SOURCES_FILE=/run/config/rag-sources.json
BFF_POSE_ORIGIN=https://pose.internal:3443
# Optional browser-visible origin of the versioned Pose bucket. Enables upload routes.
BFF_POSE_UPLOAD_ORIGIN=https://pose-objects.example.invalid
BFF_POSE_TLS_KEY_FILE=/run/secrets/web-bff-client.key
BFF_POSE_TLS_CERT_FILE=/run/secrets/web-bff-client.crt
BFF_POSE_TLS_CA_FILE=/run/secrets/pose-ca.crt
# Catalog CMS routes use the private TLS listener from T11.
BFF_CATALOG_ADMIN_ORIGIN=https://catalog-admin.internal:3101
BFF_CATALOG_ADMIN_KEY_FILE=/run/secrets/web-bff-client.key
BFF_CATALOG_ADMIN_CERT_FILE=/run/secrets/web-bff-client.crt
BFF_CATALOG_ADMIN_CA_FILE=/run/secrets/catalog-admin-ca.crt
# Optional browser-visible origin of the private Catalog media bucket.
BFF_CATALOG_MEDIA_ORIGIN=https://catalog-objects.example.invalid
# Workout owner APIs. JWT is obtained server-side from Identity for each request.
BFF_WORKOUT_ORIGIN=https://workout.internal:3444
BFF_WORKOUT_KEY_FILE=/run/secrets/web-bff-client.key
BFF_WORKOUT_CERT_FILE=/run/secrets/web-bff-client.crt
BFF_WORKOUT_CA_FILE=/run/secrets/workout-ca.crt
BFF_PROGRESS_ORIGIN=https://progress.internal:3445
BFF_PROGRESS_KEY_FILE=/run/secrets/web-bff-client.key
BFF_PROGRESS_CERT_FILE=/run/secrets/web-bff-client.crt
BFF_PROGRESS_CA_FILE=/run/secrets/progress-ca.crt
BFF_NOTIFICATION_ORIGIN=https://notification.internal:3003
BFF_NOTIFICATION_KEY_FILE=/run/secrets/web-bff-client.key
BFF_NOTIFICATION_CERT_FILE=/run/secrets/web-bff-client.crt
BFF_NOTIFICATION_CA_FILE=/run/secrets/notification-ca.crt
