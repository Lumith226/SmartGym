        },
        "targetDurationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      }
    },
    "ExercisePublicMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url",
        "altText"
      ],
      "properties": {
        "kind": {
          "type": "string",
