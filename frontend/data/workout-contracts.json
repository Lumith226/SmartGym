          "required": [
            "targetDurationSeconds"
          ]
        }
      ],
      "unevaluatedProperties": false,
      "properties": {
        "exerciseId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        },
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "targetReps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "targetDurationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      }
    },
    "WorkoutPlanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exerciseId",
        "sets",
        "exerciseNameVi"
      ],
      "oneOf": [
        {
          "required": [
