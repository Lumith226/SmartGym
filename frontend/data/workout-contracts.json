      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,79}$",
          "examples": [
            "bodyweight_squat"
          ]
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 100,
          "examples": [
            "squat-khong-ta"
          ]
        },
        "nameVi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
