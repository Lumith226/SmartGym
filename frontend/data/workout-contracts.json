          },
          "maxItems": 1
        }
      }
    },
    "WorkoutPlanItemInput": {
      "type": "object",
      "required": [
        "exerciseId",
        "sets"
      ],
      "oneOf": [
        {
          "required": [
            "targetReps"
          ]
        },
