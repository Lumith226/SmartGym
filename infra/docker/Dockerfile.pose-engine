FROM scratch AS engine-source
COPY backend/apps/pose/engine/main.py backend/apps/pose/engine/directml.py /app/engine/
COPY backend/apps/pose/data/models.json /app/data/models.json

FROM python:3.12-slim-bookworm AS base
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.5.1
RUN pip install --no-cache-dir fastapi==0.162.0 uvicorn==0.54.0 wsproto==1.3.2 python-multipart==0.0.33 \
    opentelemetry-distro==0.66b2 opentelemetry-instrumentation-fastapi==0.66b2 opentelemetry-exporter-otlp-proto-http==1.45.2 \
    numpy==2.0.2 onnx==1.23.1 opencv-contrib-python==4.12.0.88 \
    pillow==11.3.0 scipy==1.18.1
# rtmlib declares the CPU ORT distribution even when using the GPU wheel.
RUN pip install --no-cache-dir --no-deps rtmlib==0.0.16 tqdm==4.70.1
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
ENTRYPOINT ["opentelemetry-instrument", "python", "engine/main.py"]

FROM base AS cuda
COPY infra/ai/pose-cuda.linux-x64.txt /tmp/pose-cuda.txt
RUN pip install --no-cache-dir -r /tmp/pose-cuda.txt \
    && find /usr/local/lib/python3.12/site-packages/nvidia -type d -name lib > /etc/ld.so.conf.d/smartgym-cuda.conf \
    && ldconfig
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
COPY --from=engine-source /app/ /app/
USER 1000:1000

FROM base AS cpu
RUN pip install --no-cache-dir onnxruntime==1.31.1
COPY --from=engine-source /app/ /app/
USER 1000:1000
