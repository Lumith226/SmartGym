FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.5.1
RUN pip install --no-cache-dir fastapi==0.162.0 uvicorn==0.54.0 wsproto==1.3.2 python-multipart==0.0.33 \
    numpy==2.0.2 onnx==1.23.1 onnxruntime==1.31.1 opencv-python==4.12.0.88 \
    pillow==11.3.0 rtmlib==0.0.16 scipy==1.18.1
WORKDIR /app
COPY backend/services/pose/engine/main.py engine/main.py
COPY backend/services/pose/engine/directml.py engine/directml.py
COPY backend/services/pose/data/models.json data/models.json
ENV PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
USER 1000:1000
ENTRYPOINT ["python", "engine/main.py"]
