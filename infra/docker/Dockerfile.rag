FROM python:3.12-slim-bookworm
WORKDIR /app
COPY --from=rag-source requirements.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt \
    opentelemetry-distro==0.66b2 opentelemetry-instrumentation-fastapi==0.66b2 opentelemetry-exporter-otlp-proto-http==1.45.2
COPY --from=rag-source kb_service ./kb_service
COPY --from=rag-source capabilities.json ./
ENV PYTHONDONTWRITEBYTECODE=1
USER 1000:1000
ENTRYPOINT ["opentelemetry-instrument", "python", "-m", "uvicorn", "kb_service.app:app"]
