FROM node:24.22.1-bookworm-slim
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY backend/apps/catalog/package.json backend/apps/catalog/
COPY backend/apps/identity/package.json backend/apps/identity/
COPY backend/apps/notification/package.json backend/apps/notification/
COPY backend/apps/pose/package.json backend/apps/pose/
COPY backend/apps/workout/package.json backend/apps/workout/
COPY backend/apps/progress/package.json backend/apps/progress/
COPY frontend/package.json frontend/
COPY backend/package.json backend/
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY backend/apps/identity backend/apps/identity
COPY backend/nest-cli.json backend/
RUN pnpm --filter @smartgym/identity build
WORKDIR /app/backend/apps/identity
USER node
ENV HOST=0.0.0.0
EXPOSE 3002
CMD ["node", "dist/main.js"]
