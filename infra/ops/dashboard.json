{
  "title": "SmartGym Operations",
  "uid": "smartgym-operations",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum by (service_name, status_class) (rate(smartgym_http_requests_total[2m]))" }]
    },
    {
      "id": 2,
      "title": "HTTP p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(smartgym_http_duration_seconds_bucket[5m])))" }]
    },
    {
      "id": 3,
      "title": "Process RSS (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "refId": "A", "expr": "smartgym_process_rss_bytes" }]
    },
    {
      "id": 4,
      "title": "Oldest pending outbox event (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "refId": "A", "expr": "max by (service_name) (smartgym_outbox_oldest_seconds)" }]
    }
  ]
}
