# Copy this file to .env in this directory. Never put API keys in chat or Git.
KB_INDEX_DIR=./data/index
KB_RETRIEVAL_MODE=hybrid
KB_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# Optional Qwen reasoning mode; requires separate latency/quality evaluation.
OLLAMA_THINK=false
KB_LLM_TIMEOUT=120
KB_INTERNAL_TOKEN=
# Optional graph database. JSON graph works without Docker; sync-neo4j publishes it.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
KB_GRAPH_BACKEND=local
# Optional alternative. Read only when KB_LLM_PROVIDER=openai_compatible.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
