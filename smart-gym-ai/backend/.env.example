# ──────────────────────────────────────────────────
# Smart Gym AI – Environment Variables (copy → .env)
# ──────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://smartgym:smartgym123@localhost:5432/smartgymdb

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Smart Gym AI
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# Storage
SNAPSHOT_DIR=./static/snapshots
MAX_SNAPSHOT_SIZE_KB=60

# AI Models (TV1 will fill these)
YOLO_MODEL_PATH=./models/yolov8n-pose.onnx
STGCN_MODEL_PATH=./models/stgcn_squat.onnx
STGCN_CONFIDENCE_THRESHOLD=0.5

# Knowledge Base (TV2 will fill these)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
KB_VERSION=v1.0
KB_RAG_SERVICE_URL=http://127.0.0.1:8010
KB_RAG_INTERNAL_TOKEN=
KB_RAG_TIMEOUT=150

# LLM (TV2)
QWEN_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
